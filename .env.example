# OpenRouter API Key
# 获取地址: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_api_key_here

# 新浪财经 API 基础地址
NEXT_PUBLIC_SINA_API_BASE=https://hq.sinajs.cn

# Supabase PostgreSQL 数据库连接
# 获取地址: Supabase Dashboard > Settings > Database > Connection string > Transactional mode
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.com:5432/postgres

# JWT 密钥 (用于生成 session token)
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# 用户账户 (初始账户，由初始化脚本创建)
ADMIN_USER=admin
ADMIN_PASS=your_admin_password_here
TRADER_USER=trader
TRADER_PASS=your_trader_password_here
